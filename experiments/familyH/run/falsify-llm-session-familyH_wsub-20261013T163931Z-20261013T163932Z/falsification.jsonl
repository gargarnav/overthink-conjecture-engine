{"conjecture_id": "C-d3ddf18b5364", "kind": "claim_predicate", "sequence_id": "wsub_subsets5_n1000/data|claim:a50bd1183c", "statement": "For S = {1,2,3} and S = {1,2,3,5}: (x,y) is a P-position iff (x mod 4, y mod 4) is one of (0,0), (1,2), (2,1), i.e. a Wythoff P-position with both coordinates < 4.", "second_order": false, "status": "survived", "per_sequence": [{"n_checked": 2000000, "n_violations": 0, "status": "holds", "sequence_id": "wsub_subsets5_n1000/data|claim:a50bd1183c", "window_checked": 20000, "reason": null}]}
{"conjecture_id": "C-29c870df0910", "kind": "claim_predicate", "sequence_id": "wsub_subsets5_n1000/data|claim:956837e395", "statement": "For S = {1,2,3,4}: (x,y) is a P-position iff (x mod 5, y mod 5) is a Wythoff P-position with both coordinates < 5: (0,0), (1,2), (2,1).", "second_order": false, "status": "survived", "per_sequence": [{"n_checked": 1000000, "n_violations": 0, "status": "holds", "sequence_id": "wsub_subsets5_n1000/data|claim:956837e395", "window_checked": 10000, "reason": null}]}
{"conjecture_id": "C-f33f6adef86a", "kind": "claim_predicate", "sequence_id": "wsub_subsets5_n1000/data|claim:c1738b11d7", "statement": "For S = {1,2,3,4,5}: (x,y) is a P-position iff (x mod 6, y mod 6) is a Wythoff P-position with both coordinates < 6: (0,0), (1,2), (2,1), (3,5), (5,3). Conjecturally W({1..k}) reduces to Wythoff modulo k+1 for every k.", "second_order": false, "status": "survived", "per_sequence": [{"n_checked": 1000000, "n_violations": 0, "status": "holds", "sequence_id": "wsub_subsets5_n1000/data|claim:c1738b11d7", "window_checked": 10000, "reason": null}]}
{"conjecture_id": "C-baa7827f3bf2", "kind": "claim_predicate", "sequence_id": "wsub_subsets5_n1000/data|claim:5b058d006e", "statement": "For S = {2,3}: (x,y) is a P-position iff with m = 5: x mod m < 2 and y mod m < 2, or (x mod m, y mod m) is (2,4) or (4,2). Conjecturally this holds for every pair {a, a+1} (a = 1 gives (x+y) mod 3 = 0).", "second_order": false, "status": "survived", "per_sequence": [{"n_checked": 1000000, "n_violations": 0, "status": "holds", "sequence_id": "wsub_subsets5_n1000/data|claim:5b058d006e", "window_checked": 10000, "reason": null}]}
{"conjecture_id": "C-bcf5e85fef4e", "kind": "claim_predicate", "sequence_id": "wsub_subsets5_n1000/data|claim:35990c1ed4", "statement": "For S = {3,4}: (x,y) is a P-position iff with m = 7: x mod m < 3 and y mod m < 3, or (x mod m, y mod m) is (3,6) or (6,3). Conjecturally this holds for every pair {a, a+1} (a = 1 gives (x+y) mod 3 = 0).", "second_order": false, "status": "survived", "per_sequence": [{"n_checked": 1000000, "n_violations": 0, "status": "holds", "sequence_id": "wsub_subsets5_n1000/data|claim:35990c1ed4", "window_checked": 10000, "reason": null}]}
{"conjecture_id": "C-842f878b9d8f", "kind": "claim_predicate", "sequence_id": "wsub_subsets5_n1000/data|claim:dfec26cdc2", "statement": "For S = {4,5}: (x,y) is a P-position iff with m = 9: x mod m < 4 and y mod m < 4, or (x mod m, y mod m) is (4,8) or (8,4). Conjecturally this holds for every pair {a, a+1} (a = 1 gives (x+y) mod 3 = 0).", "second_order": false, "status": "survived", "per_sequence": [{"n_checked": 1000000, "n_violations": 0, "status": "holds", "sequence_id": "wsub_subsets5_n1000/data|claim:dfec26cdc2", "window_checked": 10000, "reason": null}]}
{"conjecture_id": "C-68957d5d0ab6", "kind": "claim_predicate", "sequence_id": "wsub_subsets5_n1000/data|claim:e2f269e20b", "statement": "For S = {2,3,4,5} and S = {2,3,5}: the P-positions are exactly the (x,y) with (x mod 7, y mod 7) in {0,1}x{0,1} or in {(2,4),(2,5),(3,5),(3,6),(4,2),(5,2),(5,3),(6,3)}.", "second_order": false, "status": "survived", "per_sequence": [{"n_checked": 2000000, "n_violations": 0, "status": "holds", "sequence_id": "wsub_subsets5_n1000/data|claim:e2f269e20b", "window_checked": 20000, "reason": null}]}
{"conjecture_id": "C-ee158cd3d0a6", "kind": "claim_predicate", "sequence_id": "wsub_subsets5_n1000/data|claim:77719221b3", "statement": "For S = {3,5}: (x,y) is a P-position iff (x mod 8, y mod 8) is in {0,1,2}^2, {3,4}x{6,7} or {6,7}x{3,4}.", "second_order": false, "status": "survived", "per_sequence": [{"n_checked": 1000000, "n_violations": 0, "status": "holds", "sequence_id": "wsub_subsets5_n1000/data|claim:77719221b3", "window_checked": 10000, "reason": null}]}
{"conjecture_id": "C-09a0049730a0", "kind": "claim_predicate", "sequence_id": "wsub_subsets5_n1000/data|claim:c514592809", "statement": "For S = {1,4}: with u = min(x,y), v = max(x,y), (x,y) is a P-position iff (u mod 5, v mod 5) is in {(0,0),(0,2),(1,4),(2,2),(3,1),(3,4),(4,3)}. The pattern is periodic with period 5 on each side of the diagonal but not symmetric across it.", "second_order": false, "status": "survived", "per_sequence": [{"n_checked": 1000000, "n_violations": 0, "status": "holds", "sequence_id": "wsub_subsets5_n1000/data|claim:c514592809", "window_checked": 10000, "reason": null}]}
{"conjecture_id": "C-abeb8a54c09b", "kind": "claim_predicate", "sequence_id": "wsub_subsets5_n1000/data|claim:20f5e6bda7", "statement": "For S = {2,3,4}: with u = min(x,y), v = max(x,y), (x,y) is a P-position iff (u mod 6, v mod 6) is in {0,1}x{0,1} or {(2,4),(2,5),(3,5),(4,2),(5,3)}.", "second_order": false, "status": "survived", "per_sequence": [{"n_checked": 1000000, "n_violations": 0, "status": "holds", "sequence_id": "wsub_subsets5_n1000/data|claim:20f5e6bda7", "window_checked": 10000, "reason": null}]}
