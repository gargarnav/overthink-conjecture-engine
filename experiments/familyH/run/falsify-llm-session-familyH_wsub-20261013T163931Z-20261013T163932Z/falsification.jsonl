{"conjecture_id": "C-93c3201cd739", "kind": "claim_predicate", "sequence_id": "wsub_subsets5_n1000/data|claim:e0a4450718", "statement": "For every S consisting of odd numbers with 1 in S (here {1}, {1,3}, {1,5}, {1,3,5}), the Grundy value is G(x,y) = 0 if x,y both even; 2 if both odd; for mixed parity 1 if the odd coordinate is the larger one, else 3.", "second_order": false, "status": "survived", "per_sequence": [{"n_checked": 4000000, "n_violations": 0, "status": "holds", "sequence_id": "wsub_subsets5_n1000/data|claim:e0a4450718", "window_checked": 40000, "reason": null}]}
{"conjecture_id": "C-c1b83a40d330", "kind": "claim_predicate", "sequence_id": "wsub_subsets5_n1000/data|claim:a87ec015eb", "statement": "If 1 and 2 are in S and no element of S is divisible by 3 (here {1,2}, {1,2,4}, {1,2,5}, {1,2,4,5}), then G(x,y) = (x + y) mod 3.", "second_order": false, "status": "survived", "per_sequence": [{"n_checked": 4000000, "n_violations": 0, "status": "holds", "sequence_id": "wsub_subsets5_n1000/data|claim:a87ec015eb", "window_checked": 40000, "reason": null}]}
{"conjecture_id": "C-44dd788d11ac", "kind": "claim_predicate", "sequence_id": "wsub_subsets5_n1000/data|claim:c841507145", "statement": "Scaling: for S = {2}, G(x,y) = G_{1}(floor(x/2), floor(y/2)) with G_{1} the formula of H01.", "second_order": false, "status": "survived", "per_sequence": [{"n_checked": 1000000, "n_violations": 0, "status": "holds", "sequence_id": "wsub_subsets5_n1000/data|claim:c841507145", "window_checked": 10000, "reason": null}]}
